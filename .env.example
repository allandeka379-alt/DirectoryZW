# Copy to .env and fill in. Everything has a working default for local development.

NODE_ENV=development
PORT=3000

# Shown to customers and businesses. Placeholder until the product is named.
BRAND_NAME=Directory ZW
PRIVACY_URL=
BUSINESS_TERMS_URL=

# Database: leave DATABASE_URL empty to use embedded Postgres (PGlite) stored in PGLITE_DIR.
DATABASE_URL=
PGLITE_DIR=./.data/pglite
# Load clearly-labelled sample businesses for local testing (never in production).
SEED_SAMPLE_DATA=true

# Field photos are stored here. Public address of this server, used in agents' setup links.
UPLOADS_DIR=./.data/uploads
PUBLIC_BASE_URL=http://localhost:3000

# Claude: without a key the app falls back to a simple keyword interpreter, and photos and
# "found online" results are switched off.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# "Found online": when nothing is listed, search the web (Claude's web search tool) and show what
# it finds, marked as unchecked. Web search must be enabled for your organization in the Claude Console.
ONLINE_SEARCH=true
# Days a business found online is kept for the field team to invite before it is deleted.
ONLINE_LEAD_DAYS=30
# Web searches one customer can trigger per day (repeat searches reuse earlier finds and don't count).
ONLINE_SEARCHES_PER_DAY=5

# Voice notes: a speech-to-text service behind a small HTTP contract (see README). Leave empty to
# reply "please type" (the simulator fakes it: you type what the voice note says).
SPEECH_TO_TEXT_URL=
SPEECH_TO_TEXT_TOKEN=
SPEECH_LANGUAGES=sn,nd,en
# Largest photo or voice note to download, in MB.
MAX_MEDIA_MB=16

# WhatsApp: "simulator" keeps everything local (open http://localhost:3000/simulator);
# "cloud" sends through Meta's WhatsApp Cloud API and needs the values below.
WHATSAPP_TRANSPORT=simulator
WHATSAPP_GRAPH_VERSION=v24.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Phone number IDs from Meta (one number for customers, one for businesses).
WHATSAPP_CUSTOMER_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_PHONE_NUMBER_ID=
# The two numbers in international format, digits only (used in links and messages).
WHATSAPP_CUSTOMER_NUMBER=263770000000
WHATSAPP_BUSINESS_NUMBER=263770000001

# Message templates approved in Meta, used when the 24-hour window is closed.
TEMPLATE_LANGUAGE=en
TEMPLATE_LEAD_NOTIFICATION=lead_notification
TEMPLATE_FOLLOW_UP=follow_up
TEMPLATE_ASK_AROUND=ask_around
TEMPLATE_ASK_AROUND_REPLY=ask_around_reply
TEMPLATE_WEEKLY_SUMMARY=weekly_summary

# Bearer token for the /ops API. Required outside development.
OPS_TOKEN=

FOLLOW_UP_DELAY_HOURS=72
# Show unverified businesses only when fewer than this many verified ones match.
MIN_VERIFIED_RESULTS=3
MAX_RESULTS=8
JOB_POLL_SECONDS=15
