# Copy to .env and fill in. Everything has a working default for local development.

NODE_ENV=development
PORT=3000

# Shown to customers and businesses. Placeholder until the product is named.
BRAND_NAME=Directory ZW
PRIVACY_URL=
BUSINESS_TERMS_URL=

# Database: leave DATABASE_URL empty to use embedded Postgres (PGlite) stored in PGLITE_DIR.
DATABASE_URL=
PGLITE_DIR=./.data/pglite
# Load clearly-labelled sample businesses for local testing (never in production).
SEED_SAMPLE_DATA=true

# Field photos are stored here. Public address of this server, used in agents' setup links.
UPLOADS_DIR=./.data/uploads
PUBLIC_BASE_URL=http://localhost:3000

# Claude: requests are understood locally first. Claude is asked only about wording the local
# engine can't read (then remembered). Without a key, everything is local. Customers and businesses
# type their messages: voice notes and photos get a polite "please type" reply.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
# Claude spending stops for the rest of the day (Harare time) once this is used; then requests are
# understood locally or go to the team.
CLAUDE_DAILY_BUDGET_USD=5
# Claude calls one WhatsApp number can cause per day.
CLAUDE_CALLS_PER_NUMBER_PER_DAY=5
# The Shona and Ndebele word lists start as drafts for native speakers to review (ops console: Word
# list). Until a word is approved, requests that depend on it get a "Did you mean…?" question. true
# uses the drafts as if approved.
LEXICON_TRUST_DRAFTS=false
# When a person answers chats handed to the team (Harare time). Customers are told when to expect
# a reply: "soon", or "our team is back at 8am on Monday".
TEAM_HOURS=Mon-Sat 08:00-18:00

# The local engine's thresholds (tune with npm run eval -- --tune on labelled real requests):
# how many unknown words a straight answer may have, per language, and how closely an unknown
# word must match a known one for the classifier to offer it as "Did you mean…?" (0 switches it off).
LOCAL_UNKNOWN_WORDS=en:1,sn:0,nd:0
LOCAL_CLASSIFIER_MIN=0.4

# Field agents' photos of businesses: "disk" (UPLOADS_DIR) or "s3" for Amazon S3, Cloudflare R2 or
# another S3-compatible store.
STORAGE=disk
S3_BUCKET=
# "auto" for R2
S3_REGION=auto
# e.g. https://<account-id>.r2.cloudflarestorage.com (leave empty for AWS)
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=
S3_FORCE_PATH_STYLE=false

# Alerts (Slack, Discord or Google Chat incoming webhook). Without it, alerts are only logged.
ALERT_WEBHOOK_URL=

# Limits per WhatsApp number, against floods and abuse.
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_DAY=300
REPORTS_PER_DAY=3
# Pause a listing when this many customers who contacted it report it within 30 days (0 = never).
REPORTS_TO_PAUSE=3

# How long conversation data is kept, in days (see docs/DATA_PROTECTION.md).
MESSAGE_RETENTION_DAYS=180
REQUEST_RETENTION_DAYS=365

# Hours before someone has to sign in to the ops console again.
OPS_SESSION_HOURS=12

# WhatsApp: "simulator" keeps everything local (open http://localhost:3000/simulator);
# "cloud" sends through Meta's WhatsApp Cloud API and needs the values below.
WHATSAPP_TRANSPORT=simulator
WHATSAPP_GRAPH_VERSION=v24.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Phone number IDs from Meta (one number for customers, one for businesses).
WHATSAPP_CUSTOMER_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_PHONE_NUMBER_ID=
# The two numbers in international format, digits only (used in links and messages).
WHATSAPP_CUSTOMER_NUMBER=263770000000
WHATSAPP_BUSINESS_NUMBER=263770000001
# WhatsApp Business Account ID, for submitting message templates (npm run templates).
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Message templates approved in Meta, used when the 24-hour window is closed.
TEMPLATE_LANGUAGE=en
TEMPLATE_LEAD_NOTIFICATION=lead_notification
TEMPLATE_FOLLOW_UP=follow_up
TEMPLATE_WEEKLY_SUMMARY=weekly_summary

# Shared bearer token for the /ops API: for scripts and the first sign-in. Required in production.
# People use their own accounts (npm run ops:user). In development, with no token and no accounts
# yet, the ops console is open.
OPS_TOKEN=

FOLLOW_UP_DELAY_HOURS=72
# Show unverified businesses only when fewer than this many verified ones match.
MIN_VERIFIED_RESULTS=3
MAX_RESULTS=8
JOB_POLL_SECONDS=15
