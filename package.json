{
  "name": "findzim",
  "version": "0.1.0",
  "private": true,
  "description": "WhatsApp-native directory: customers ask for anything, we connect them with local businesses.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:seed": "tsx src/db/seed-cli.ts",
    "ops:user": "tsx src/ops/user-cli.ts",
    "templates": "tsx src/whatsapp/templates-cli.ts",
    "eval": "tsx src/eval/run.ts",
    "eval:export": "tsx src/eval/export.ts",
    "explain": "tsx src/eval/explain.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@aws-sdk/client-s3": "^3.1140.0",
    "@electric-sql/pglite": "^0.5.8",
    "dotenv": "^18.0.3",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
